repository-code: "https://github.com/antonio-lozano/coping-dynamics-sequencing"
keywords:
  - "behavioral neuroscience"
  - "keypoint-MoSeq"
  - "unsupervised behavior segmentation"
  - "early-life stress"
  - "stress coping"
  - "resilience"
  - "reproducible research"
