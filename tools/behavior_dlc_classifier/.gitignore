# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.venv/
.venv-dlc/
venv/
*.egg-info/

# Editor and assistant settings belonging to one machine, not to the tool.
.claude/
.vscode/
.idea/

# Retired and locally generated models. These are never committed.
models/archive/
models/manual_refined_*.sav
output/retrained_model.sav
output/feature_cache/

# Retired Windows-only helper scripts, superseded by scripts/train_model.py.
scripts/archive/

# Shipped model binaries.
# The .pkl rules below also override the parent repository's global "*.pkl"
# pattern once this tool is nested inside it, which is why they are listed
# explicitly rather than relying on the absence of an ignore rule.
!models/freezing_model.sav
!models/behavior/xgb_model.pkl
!models/behavior/label_encoder.pkl

# Refilled from the videos on every run.
data/raw/DLC_filtered/*
!data/raw/DLC_filtered/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Run outputs
output/predictions/*
!output/predictions/.gitkeep
output/annotated_videos/*
!output/annotated_videos/.gitkeep
output/summaries/*
!output/summaries/.gitkeep
output/features/
output/_dlc_working/

# Analysis packages created by the GUI next to the selected videos
*_analysis/
*_analysis_[0-9]*/

# Legacy output locations, anchored to the repository root on purpose so they
# do not also match the folders under output/.
/freezing_predictions/
/annotated_videos/
/freezing_summary.xlsx

# Generated by the tool next to a DeepLabCut project config, so DeepLabCut
# reads a correct project_path without the committed config.yaml being edited.
dlc_config_resolved.yaml

# The full 4046-feature freezing model is the prediction default but is ~1 GB,
# far past any git host limit. It is distributed as a release asset instead.
models/freezing_model_full.sav
